<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Los comentarios XML se generan para Swagger; no exigimos documentar cada miembro público. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>1adef0fd-ffb1-4ed6-97f7-74b1f799e012</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remates.Domain\Remates.Domain.csproj" />
    <ProjectReference Include="..\Remates.Infrastructure\Remates.Infrastructure.csproj" />
  </ItemGroup>

</Project>
