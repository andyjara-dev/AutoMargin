# Copiar a .env en el servidor y rellenar. Este archivo NO se versiona.
#
# Generar los secretos en el propio servidor, sin escribirlos a mano:
#   openssl rand -base64 48   → JWT_SIGNING_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD

# ---------- Base de datos ----------
POSTGRES_DB=automargin
POSTGRES_USER=automargin
POSTGRES_PASSWORD=

# ---------- Firma de tokens ----------
# Mínimo 32 caracteres. Cambiarla invalida todas las sesiones abiertas.
JWT_SIGNING_KEY=
JWT_ISSUER=automargin
JWT_AUDIENCE=automargin-web
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# ---------- Administrador inicial ----------
# Solo se crea la primera vez. Después, cambiar la contraseña aquí no tiene efecto:
# el sembrado no toca un usuario que ya existe.
#
# La contraseña DEBE cumplir, o la cuenta no se crea y el login responderá 401:
#   - al menos 10 caracteres
#   - al menos una mayúscula, una minúscula y un dígito
#
# Y por cómo se leen los archivos .env, evita estos caracteres en el valor:
#   #  inicia un comentario y trunca la contraseña
#   $  se interpreta como variable y se sustituye
# Si necesitas usarlos, envuelve el valor en comillas simples.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Fuentes de mercado (opcional) ----------
# Sin nada de esto el sistema funciona igual: la pantalla de Mercado sigue permitiendo pegar
# avisos a mano, que es la vía que no depende de ningún tercero.
#
# Ninguna necesita credenciales: las dos leen el HTML público de cada portal, cuyos robots.txt
# permiten esas rutas. Vienen apagadas porque una lectura de HTML se rompe cuando el sitio
# cambia de maquetado, y encenderlas es decisión tuya.
#
# MercadoLibre NO usa su API oficial: esa solo permite listar publicaciones de un vendedor
# concreto, y para comparar precios hacen falta avisos de muchos vendedores. Ver DESPLIEGUE.md.
ML_ENABLED=false
YAPO_ENABLED=false

# Segundos mínimos entre peticiones a un mismo sitio. Bajarlo es pedir un bloqueo.
MARKET_MIN_SECONDS=3

# ---------- Publicación ----------
PUBLIC_URL=https://automargin.andyjara.dev
# Puerto local al que apuntara el proxy. Verificar que este libre:  ss -ltnp | grep 8090
PUBLIC_PORT=8090
