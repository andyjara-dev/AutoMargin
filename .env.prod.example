# Copiar a .env en el servidor y rellenar. Este archivo NO se versiona.
#
# Generar los secretos en el propio servidor, sin escribirlos a mano:
#   openssl rand -base64 48   → JWT_SIGNING_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD

# ---------- Base de datos ----------
POSTGRES_DB=automargin
POSTGRES_USER=automargin
POSTGRES_PASSWORD=

# ---------- Firma de tokens ----------
# Mínimo 32 caracteres. Cambiarla invalida todas las sesiones abiertas.
JWT_SIGNING_KEY=
JWT_ISSUER=automargin
JWT_AUDIENCE=automargin-web
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# ---------- Administrador inicial ----------
# Solo se crea la primera vez. Después, cambiar la contraseña aquí no tiene efecto:
# el sembrado no toca un usuario que ya existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Publicación ----------
PUBLIC_URL=https://automargin.andyjara.dev
# Puerto local al que apuntará el Nginx del servidor.
PUBLIC_PORT=8080
